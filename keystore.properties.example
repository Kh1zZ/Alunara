# Salin file ini menjadi `keystore.properties` (sudah di-ignore di .gitignore)
# atau gunakan script `scripts/generate-keystore.ps1`.
# Jangan pernah meng-commit `keystore.properties` atau file `.jks` ke Git!
#
# Alternatif di CI/CD (GitHub Actions), gunakan environment variables:
#   ALUNARA_KEYSTORE_FILE
#   ALUNARA_KEYSTORE_PASSWORD
#   ALUNARA_KEY_ALIAS
#   ALUNARA_KEY_PASSWORD

storeFile=alunara-release.jks
storePassword=CHANGE_ME_STRONG_STORE_PASSWORD
keyAlias=alunara-release
keyPassword=CHANGE_ME_STRONG_KEY_PASSWORD
